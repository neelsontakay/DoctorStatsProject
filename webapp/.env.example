# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME=DoctorStats
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

# Hosts that receive session cookies for the SPA (include your dev port)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8080,127.0.0.1,127.0.0.1:8000,127.0.0.1:8080

# Native dev without Docker — see docs/Native_Dev_Setup.md and scripts/start-native-dev.ps1
STATS_SERVICE_URL=http://127.0.0.1:8001
STATS_SERVICE_TOKEN=local-dev-token

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Database (MySQL 8.0+)
# Docker Compose service: mysql
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=doctorstats
DB_USERNAME=doctorstats
DB_PASSWORD=secret

# ------------------------------------------------------------------
# Redis (cache, session, queues)
# Docker Compose service: redis
# ------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log

# ------------------------------------------------------------------
# File Storage (S3-compatible: MinIO locally, AWS S3 / DO Spaces in prod)
# Docker Compose service: minio (console at http://localhost:9001)
# ------------------------------------------------------------------
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=doctorstats
AWS_SECRET_ACCESS_KEY=secret-minio
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=doctorstats-local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ------------------------------------------------------------------
# Mail - ZeptoMail in production, Mailpit catches mail locally
# Docker Compose service: mailpit (UI at http://localhost:8025)
# ------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@doctorstats.test"
MAIL_FROM_NAME="${APP_NAME}"

# ZeptoMail API (production email delivery)
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_BOUNCE_ADDRESS=

# ------------------------------------------------------------------
# Payments - Zoho Pay
# Local: leave keys empty and keep DOCTORSTATS_PAYMENT_STUB=true.
# Production: set keys, register webhook at /internal/v1/webhooks/zoho,
# and set DOCTORSTATS_PAYMENT_STUB=false.
# See docs/Production_Integrations.md
# ------------------------------------------------------------------
ZOHO_PAY_API_KEY=
ZOHO_PAY_ACCOUNT_ID=
ZOHO_PAY_WEBHOOK_SECRET=
ZOHO_PAY_BASE_URL=https://payments.zoho.com/api/v1

# ------------------------------------------------------------------
# AI Providers - Anthropic Claude (primary), Google Gemini (fallback)
# Local: keep DOCTORSTATS_AI_STUB=true (no API keys needed).
# Production: set DOCTORSTATS_AI_STUB=false and provide at least one key.
# Provider order when stub is off: Anthropic -> Gemini -> stub fallback.
# See docs/Production_Integrations.md
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------
# Statistical Analysis Service (Python FastAPI)
# Docker Compose service: stats-service
# ------------------------------------------------------------------
STATS_SERVICE_URL=http://stats-service:8001
STATS_SERVICE_TOKEN=
STATS_SERVICE_TIMEOUT=900
# Set true in production so internal routes reject requests without X-Service-Token
STATS_SERVICE_REQUIRE_TOKEN=false

# DoctorStats app settings
# Stubs: true for local dev, false for production (requires Zoho Pay + AI keys above)
DOCTORSTATS_PAYMENT_STUB=true
DOCTORSTATS_AI_STUB=true
DOCTORSTATS_PAY_PER_JOB_AMOUNT=999.00
DOCTORSTATS_MAX_UPLOAD_BYTES=52428800
DOCTORSTATS_SHARE_EXPIRY_DAYS=7

# ------------------------------------------------------------------
# Error Tracking - Sentry
# ------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

VITE_APP_NAME="${APP_NAME}"
